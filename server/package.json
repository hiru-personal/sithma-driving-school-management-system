{
  "name": "sithma-driving-school-server",
  "version": "1.0.0",
  "description": "Backend API for Sithma Driving School Management System",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "mongo:start": "mkdir -p ~/.mongodb/data ~/.mongodb/log && mongod --dbpath ~/.mongodb/data --logpath ~/.mongodb/log/mongod.log --fork",
    "seed": "node seed/seedAll.js",
    "sync:atlas": "node syncAtlas.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-validator": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.1",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.2"
  }
}
